# Direct Postgres connection (Supabase Project Settings -> Connect -> connection string).
# Used by every script in scripts/ via psycopg2 - never the anon key.
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Supabase Project Settings -> API Keys. (Frontend arrives in a later phase -
# kept here now so this file stays complete from day one.)
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_ID].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# GitHub Actions personal access token with `workflow` scope, used only by the
# admin "recompute now" button to trigger the refresh workflow on demand.
# (Added when the admin UI/deployment phases land.)
GITHUB_ACTIONS_TOKEN=

# DreamTeamTonic Premium login - only needed once a Premium market-odds
# scraper exists (not built yet, see CLAUDE.md Status). Your own account,
# your own credentials - never committed, never shared in chat.
DREAMTEAMTONIC_EMAIL=
DREAMTEAMTONIC_PASSWORD=
